      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1hfbbm318rwgsq132p9ae0bv6li8].[avg:LIMIT_BAL:qk]&quot;' value='Avg. Limit Kredit' />
          <alias key='&quot;[federated.1hfbbm318rwgsq132p9ae0bv6li8].[ctd:ID:qk]&quot;' value='Status Payment' />
