      </column>
      <column datatype='integer' name='[AGE]' role='measure' type='quantitative' />
      <column caption='Bill Amt1' datatype='real' name='[BILL_AMT1]' role='measure' type='quantitative' />
      <column caption='Bill Amt2' datatype='real' name='[BILL_AMT2]' role='measure' type='quantitative' />
      <column caption='Bill Amt3' datatype='real' name='[BILL_AMT3]' role='measure' type='quantitative' />
      <column caption='Bill Amt4' datatype='real' name='[BILL_AMT4]' role='measure' type='quantitative' />
      <column caption='Bill Amt5' datatype='real' name='[BILL_AMT5]' role='measure' type='quantitative' />
      <column caption='Bill Amt6' datatype='real' name='[BILL_AMT6]' role='measure' type='quantitative' />
      <column caption='Default rate' datatype='real' name='[Calculation_2173251818336256]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [default.payment.next.month] = 1 THEN 1 ELSE 0 END) &#13;&#10;/ &#13;&#10;COUNT([ID])' />
      </column>
      <column caption='Avg Credit Limit' datatype='real' default-format='*Rp #,##0,, &quot;jt&quot;;-&quot;Rp #,##0,,, &quot;M&quot;' name='[Calculation_2173251818893313]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([LIMIT_BAL])' />
      </column>
      <column caption='Risk Tier' datatype='string' name='[Calculation_2173251829891075]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Pivot Field Values] &lt;= -1 THEN &quot;On time / early&quot;&#13;&#10;ELSEIF [Pivot Field Values] = 0 THEN &quot;Partially paid&quot;&#13;&#10;ELSEIF [Pivot Field Values] &lt;= 2 THEN &quot;1–2 mo delay&quot;&#13;&#10;ELSE &quot;3+ mo delay&quot;&#13;&#10;END' />
      </column>
      <column caption='Risk Order' datatype='integer' name='[Calculation_2173251829964804]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_2173251829891075] = &quot;On time / early&quot; THEN 1&#13;&#10;ELSEIF [Calculation_2173251829891075] = &quot;Partially paid&quot; THEN 2&#13;&#10;ELSEIF [Calculation_2173251829891075] = &quot;1–2 mo delay&quot; THEN 3&#13;&#10;ELSE 4&#13;&#10;END' />
      </column>
      <column caption='% of Clients' datatype='real' name='[Calculation_2173251830030341]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ID]) / TOTAL(COUNT([ID]))'>
          <table-calc ordering-type='Rows' />
        </calculation>
      </column>
      <column caption='Client Count' datatype='integer' name='[Calculation_2173251835830284]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='COUNT([ID])' />
      </column>
